# Community environment
# Copy this file to .env and fill in your values.
#
# The app reads $ENV_FILE if set, otherwise ./.env (working directory), then
# the executable's directory. Real environment variables override values in
# this file. docker compose passes this file to the container (env_file) and
# also uses it for ${...} interpolation in docker-compose.yml.

# Database: MySQL (default) or PostgreSQL. DB_CONNECTION=mysql|postgres
# (postgresql and pgsql also work). DB_PORT defaults to 3306 for MySQL and
# 5432 for PostgreSQL. DB_PASSWORD is required.
#
# docker compose: keep ONE of the four setups below. The active default is
# 2) the bundled MySQL container.
#
# 1) Bundled PostgreSQL container: leave DB_HOST and DB_PORT unset.
# COMPOSE_PROFILES=postgres
# DB_CONNECTION=postgres
#
# 2) Bundled MySQL container: leave DB_HOST and DB_PORT unset. Installs from
#    before the database profiles must add COMPOSE_PROFILES=mysql.
COMPOSE_PROFILES=mysql
DB_CONNECTION=mysql
#
# 3) External PostgreSQL server: no database profile (remove COMPOSE_PROFILES
#    or leave only other profiles). DB_SSLMODE: disable (default), require,
#    verify-ca, verify-full. DB_DSN is optional and replaces the other DB_*
#    connection fields. The citext extension is created on startup when the
#    user may run CREATE EXTENSION; otherwise create it beforehand.
# DB_CONNECTION=postgres
# DB_HOST=pg.example.internal
# DB_PORT=5432
# DB_SSLMODE=require
# DB_DSN=postgres://community:secret@pg.example.internal:5432/community?sslmode=require
#
# 4) External MySQL server: no database profile.
# DB_CONNECTION=mysql
# DB_HOST=mysql.example.internal
# DB_PORT=3306
#
# Without Docker, set DB_HOST (e.g. 127.0.0.1) and, if needed, DB_PORT.
DB_DATABASE=community
DB_USERNAME=root
DB_PASSWORD=community_secret

# Public URL with scheme (used for ActivityPub ids, acct domain, OAuth
# callbacks, e-mail links). Required in production.
APP_BASE_URL=http://localhost:8080

# Encryption key, at least 16 characters. Required. Generate one with:
#   openssl rand -base64 32
ENCRYPTED_KEY=

# Development mode (true/false). In production (false) DB_PASSWORD and
# APP_BASE_URL must be set.
# DEV_MODE=false

# Private migration staging; persist this directory across application restarts.
# It contains account backups, and site imports may contain signing keys.
# DATA_TRANSFER_DIR=.data-transfers

# Meilisearch. Unset or auto: use the engine when it answers, build the
# indexes, and keep them updated. If it is down, search uses the database
# and switches back when the engine returns. false turns this off.
#
# Local process: leave HOST unset (defaults to http://127.0.0.1:7700).
# Docker Compose: leave HOST unset to use the bundled meilisearch service.
# External instance: set HOST and an admin or master key. A search-only API
# key cannot create indexes. Set a prefix when the engine is shared.
# To skip the bundled container: docker compose up -d --scale meilisearch=0
# MEILISEARCH_ENABLED=auto
# MEILISEARCH_HOST=https://ms-example.meilisearch.io
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX_PREFIX=community

# Optional: S3/MinIO object storage (set STORAGE_TYPE=s3 to use)
# STORAGE_TYPE=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional: SMTP email
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
