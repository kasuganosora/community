# Community Docker Compose Environment
# Copy this file to .env and fill in your values

# Database
DB_DATABASE=community
DB_USERNAME=root
DB_PASSWORD=community_secret

# Public URL (used for ActivityPub, OAuth callbacks, etc.)
APP_BASE_URL=http://localhost:8080

# Encryption key (CHANGE THIS in production!)
ENCRYPTED_KEY=zwKc2UD3Nn8QbkypUkDbpJNyTmKeDbFbUiAGhAArpDa

# Optional: Meilisearch (full-text search)
# MEILISEARCH_ENABLED=true
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_API_KEY=

# Optional: S3/MinIO object storage (set STORAGE_TYPE=s3 to use)
# STORAGE_TYPE=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional: SMTP email
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com