# Fresh Docker Compose installation with the web wizard.
# Copy this file to .env and replace the password before starting Compose.
# Use exactly one database profile: postgres or mysql.
COMPOSE_PROFILES=postgres
BUNDLED_DB_DATABASE=community
BUNDLED_DB_USERNAME=community
# Generate a password with: openssl rand -hex 32
BUNDLED_DB_PASSWORD=replace-with-a-generated-password

# Do not add DB_* variables here before installation: they select the
# preconfigured startup path instead of the web wizard. The wizard writes
# the final application configuration to ./var/config/.env.
