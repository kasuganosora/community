# Test configuration (optional)
# Copy this file to .env.test and update values as needed. .env.test is
# git-ignored; never commit real credentials. Tests read these variables from
# the environment first, then from .env.test, and fall back to the defaults
# shown here (tests that need a real Redis are skipped or use miniredis when
# it is not reachable).

# Redis used by tests that need a real server
REDIS_TEST_HOST=127.0.0.1
REDIS_TEST_PORT=6379
REDIS_TEST_PASSWORD=
REDIS_TEST_DB=15

# Global Redis configuration (for GetStatusTimelineContent tests)
REDIS_0_HOST=127.0.0.1
REDIS_0_PORT=6379
REDIS_0_PASSWORD=
REDIS_0_DB=15
